    <model name="rubble_mound_1"><static>true</static><pose>8 12 1.5 0.3 0.2 0.8</pose><link name="link"><visual name="visual"><geometry><box><size>10 6 3</size></box></geometry><material><ambient>0.4 0.4 0.38 1</ambient><diffuse>0.5 0.5 0.48 1</diffuse></material></visual></link></model>
