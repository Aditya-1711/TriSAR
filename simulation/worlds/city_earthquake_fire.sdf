      <static>true</static><pose>45 15 2 0.1 0.5 -0.8</pose>
      <link name="link"><visual name="slab"><geometry><box><size>10 10 2</size></box></geometry><material><ambient>0.42 0.4 0.38 1</ambient><diffuse>0.52 0.5 0.48 1</diffuse></material></visual></link>
    </model>
    <model name="collapsed_building_4">
      <static>true</static><pose>-45 -15 2 -0.3 0.1 0.9</pose>
      <link name="link"><visual name="slab"><geometry><box><size>10 10 2</size></box></geometry><material><ambient>0.42 0.4 0.38 1</ambient><diffuse>0.52 0.5 0.48 1</diffuse></material></visual></link>
    </model>
    <model name="collapsed_building_5">
      <static>true</static><pose>15 -45 2 0.4 -0.2 -1.1</pose>
      <link name="link"><visual name="slab"><geometry><box><size>10 10 2</size></box></geometry><material><ambient>0.42 0.4 0.38 1</ambient><diffuse>0.52 0.5 0.48 1</diffuse></material></visual></link>
    </model>
    <model name="collapsed_building_6">
      <static>true</static><pose>-15 45 2 -0.1 0.4 0.7</pose>
      <link name="link"><visual name="slab"><geometry><box><size>10 10 2</size></box></geometry><material><ambient>0.42 0.4 0.38 1</ambient><diffuse>0.52 0.5 0.48 1</diffuse></material></visual></link>
    </model>

    <!-- 8 Overturned & Charred Wrecked Vehicles -->
    <model name="suv_wreck_1"><static>true</static><pose>4 15 1.0 0.4 1.2 0.8</pose><link name="link"><visual name="chassis"><geometry><box><size>4.5 2.0 1.6</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
