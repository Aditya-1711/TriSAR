    <!-- 7. 4 FULL 25-METER HIGH-DETAIL 3D STEEL LATTICE CELLULAR NETWORK TOWERS -->
    <model name="broken_cell_tower_1">
      <static>true</static><pose>35 25 0.0 0.35 0.15 0.3</pose>
      <link name="link">
        <!-- Main Red/White Steel Lattice Mast -->
        <visual name="mast_lower"><pose>0 0 6 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>12</length></cylinder></geometry><material><ambient>0.8 0.15 0.15 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material></visual>
        <visual name="mast_upper"><pose>0 0 18 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>12</length></cylinder></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <!-- Antenna Platform & Microwave Dish -->
        <visual name="antenna_boom"><pose>0 0 23.5 0 0 0</pose><geometry><box><size>3.6 3.6 0.4</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="microwave_dish_1"><pose>0 -1.5 19 1.57 0 0</pose><geometry><cylinder><radius>1.3</radius><length>0.35</length></cylinder></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material></visual>
        <visual name="microwave_dish_2"><pose>1.5 0 17 0 1.57 0</pose><geometry><cylinder><radius>1.0</radius><length>0.3</length></cylinder></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material></visual>
        <!-- Flashing Red Top Warning Beacon -->
        <visual name="hazard_beacon"><pose>0 0 25.0 0 0 0</pose><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>1.0 0.0 0.0 1</ambient><diffuse>1.0 0.0 0.0 1</diffuse><emissive>1.0 0.0 0.0 1</emissive></material></visual>
      </link>
    </model>

