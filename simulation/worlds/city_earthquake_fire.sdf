<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="city_earthquake_fire_world">
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Sim Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>

    <!-- Emergency Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 180 0 0 0</pose>
      <diffuse>1.0 0.9 0.8 1</diffuse>
      <specular>0.6 0.5 0.4 1</specular>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- LUSH GREEN TERRAIN GROUND PLANE (180m x 180m) -->
    <model name="city_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>180 180</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>180 180</size></plane></geometry>
          <material>
            <ambient>0.2 0.45 0.2 1</ambient>
            <diffuse>0.25 0.55 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- RICH CHARCOAL ASPHALT ROAD GRID NETWORK & BROKEN ROAD CRACKS -->
    <model name="main_avenue_ns">
      <static>true</static><pose>0 0 0.01 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>14 160 0.02</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="main_avenue_ew">
      <static>true</static><pose>0 0 0.01 0 0 1.57</pose>
      <link name="link"><visual name="visual"><geometry><box><size>14 160 0.02</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="ring_lane_north">
      <static>true</static><pose>0 50 0.01 0 0 1.57</pose>
      <link name="link"><visual name="visual"><geometry><box><size>10 160 0.02</size></box></geometry><material><ambient>0.14 0.14 0.15 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material></visual></link>
    </model>
    <model name="ring_lane_south">
      <static>true</static><pose>0 -50 0.01 0 0 1.57</pose>
      <link name="link"><visual name="visual"><geometry><box><size>10 160 0.02</size></box></geometry><material><ambient>0.14 0.14 0.15 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material></visual></link>
    </model>

    <!-- BROKEN ROAD CRACKS, ROAD CRATERS & ASPHALT FISSURES (ELEVATED Z=0.04 FOR HIGH VISIBILITY) -->
    <model name="road_crack_north_1"><static>true</static><pose>0 22 0.04 0 0 0.4</pose><link name="link"><visual name="crack"><geometry><box><size>13 3.5 0.05</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual><visual name="rubble_edge"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>13.2 0.4 0.08</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="road_crack_north_2"><static>true</static><pose>0 40 0.04 0 0 -0.5</pose><link name="link"><visual name="crack"><geometry><box><size>12 3.0 0.05</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link></model>
    <model name="road_crack_south_1"><static>true</static><pose>0 -25 0.04 0 0 -0.6</pose><link name="link"><visual name="crack"><geometry><box><size>14 3.5 0.05</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual><visual name="rubble_edge"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>14.2 0.4 0.08</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="road_crack_south_2"><static>true</static><pose>0 -42 0.04 0 0 0.3</pose><link name="link"><visual name="crack"><geometry><box><size>12 3.0 0.05</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link></model>
    <model name="road_crack_east_1"><static>true</static><pose>28 0 0.04 0 0 1.2</pose><link name="link"><visual name="crack"><geometry><box><size>13 3.5 0.05</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual><visual name="rubble_edge"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>13.2 0.4 0.08</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="road_crack_east_2"><static>true</static><pose>45 0 0.04 0 0 0.8</pose><link name="link"><visual name="crack"><geometry><box><size>11 3.0 0.05</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link></model>
    <model name="road_crack_west_1"><static>true</static><pose>-28 0 0.04 0 0 -0.8</pose><link name="link"><visual name="crack"><geometry><box><size>13 3.5 0.05</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual><visual name="rubble_edge"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>13.2 0.4 0.08</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="road_crack_west_2"><static>true</static><pose>-45 0 0.04 0 0 -0.4</pose><link name="link"><visual name="crack"><geometry><box><size>11 3.0 0.05</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link></model>

    <!-- WET MUD PATCHES & EARTH SECTORS -->
    <model name="mud_patch_1"><static>true</static><pose>0 0 0.02 0 0 0</pose><link name="link"><visual name="mud"><geometry><box><size>16 16 0.03</size></box></geometry><material><ambient>0.3 0.18 0.08 1</ambient><diffuse>0.4 0.24 0.1 1</diffuse></material></visual></link></model>
    <model name="mud_patch_2"><static>true</static><pose>15 35 0.02 0 0 0.5</pose><link name="link"><visual name="mud"><geometry><box><size>18 14 0.03</size></box></geometry><material><ambient>0.32 0.2 0.09 1</ambient><diffuse>0.42 0.26 0.12 1</diffuse></material></visual></link></model>
    <model name="mud_patch_3"><static>true</static><pose>-35 35 0.02 0 0 -0.3</pose><link name="link"><visual name="mud"><geometry><box><size>16 16 0.03</size></box></geometry><material><ambient>0.3 0.18 0.08 1</ambient><diffuse>0.4 0.24 0.1 1</diffuse></material></visual></link></model>
    <model name="mud_patch_4"><static>true</static><pose>30 -12 0.02 0 0 0.8</pose><link name="link"><visual name="mud"><geometry><box><size>15 12 0.03</size></box></geometry><material><ambient>0.32 0.2 0.09 1</ambient><diffuse>0.42 0.26 0.12 1</diffuse></material></visual></link></model>
    <model name="mud_patch_5"><static>true</static><pose>-30 -15 0.02 0 0 -0.4</pose><link name="link"><visual name="mud"><geometry><box><size>17 13 0.03</size></box></geometry><material><ambient>0.3 0.18 0.08 1</ambient><diffuse>0.4 0.24 0.1 1</diffuse></material></visual></link></model>

    <!-- 1. MOBILE UGV CHARGING STATIONS -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>ugv_pickup_alpha</name>
      <pose>20 -15 0 0 0 0</pose>
    </include>
    <model name="ugv_charging_pad_alpha">
      <static>true</static><pose>20 -15 1.45 0 0 0</pose>
      <link name="link"><visual name="charging_pad"><geometry><box><size>2.8 2.8 0.15</size></box></geometry><material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.2 0.9 0.3 1</diffuse><emissive>0.1 0.9 0.2 1</emissive></material></visual></link>
    </model>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
      <name>ugv_suv_beta</name>
      <pose>-25 -20 0 0 0 1.57</pose>
    </include>
    <model name="ugv_charging_pad_beta">
      <static>true</static><pose>-25 -20 1.55 0 0 1.57</pose>
      <link name="link"><visual name="charging_pad"><geometry><box><size>2.8 2.8 0.15</size></box></geometry><material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.2 0.9 0.3 1</diffuse><emissive>0.1 0.9 0.2 1</emissive></material></visual></link>
    </model>

    <!-- 2. DISASTER ELEMENTS: COLLAPSED BUILDINGS, WRECKED VEHICLES, RUBBLE MOUNDS, DIRT HEAPS & CELL TOWERS -->
    
    <!-- 6 Collapsed Buildings & Shattered Slab Ruins -->
    <model name="collapsed_building_1">
      <static>true</static><pose>15 35 2 0.3 0.2 0.5</pose>
      <link name="link">
        <visual name="slab1"><pose>0 0 1 0 0 0</pose><geometry><box><size>12 10 1.5</size></box></geometry><material><ambient>0.4 0.38 0.35 1</ambient><diffuse>0.5 0.48 0.45 1</diffuse></material></visual>
        <visual name="slab2"><pose>2 1 2.5 0.4 -0.2 0.3</pose><geometry><box><size>8 8 1.2</size></box></geometry><material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse></material></visual>
      </link>
    </model>
